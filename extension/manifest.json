{
  "manifest_version": 3,
  "name": "CIVIX Pocket Device",
  "version": "1.0.0",
  "description": "Sovereign application shell, universal SSO passport, and live edict notification center for Parlamentum citizens.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://civix-plum.vercel.app/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_title": "Open CIVIX Pocket Device"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
